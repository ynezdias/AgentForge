# Copy to .env at the repository root. Real credentials must remain untracked.
# Use a strong URL-safe password (letters, digits, hyphen and underscore).
POSTGRES_PASSWORD=replace_with_a_strong_url_safe_local_password
GOOGLE_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash

# Signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=replace_with_at_least_32_random_characters
# development | production. Production refuses demo accounts and demo setup.
APP_ENV=development

# Local demo accounts, created by: docker compose exec backend python -m app.db.seed_users
# Never reuse these in production.
DEMO_COMPANY_NAME=DevForge
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=replace_with_demo_admin_password
DEMO_COMPANY_EMAIL=company@example.com
DEMO_COMPANY_PASSWORD=replace_with_demo_company_password
